---
import { getEntryCTM } from "@/lib/contentParser.astro";
import Base from "@/layouts/Base.astro";
import config from ".astro/config.generated.json";
import handleDraftPage from "@/lib/utils/handleDraftPage";
import CallToAction from "@/components/sections/CallToAction.astro";
import PageHeader from "@/components/PageHeader.astro";
import { supportedLanguages } from "@/lib/utils/i18nUtils";
import BlogSection from "@/components/sections/BlogSection.astro";
import { getTaxonomy } from "@/lib/taxonomyParser.astro";
import { humanize } from "@/lib/utils/textConverter";

export async function getStaticPaths() {
  const { blogFolder } = config.settings;
  const { defaultLanguage, showDefaultLangInUrl } =
    config.settings.multilingual;

  const paths = await Promise.all(
    supportedLanguages.map(async (lang) => {
      const categories = await getTaxonomy(
        blogFolder,
        "categories",
        lang.languageCode,
      );

      return categories.map((category) => ({
        params: {
          lang:
            lang.languageCode === defaultLanguage && !showDefaultLangInUrl
              ? undefined
              : lang.languageCode,
          category: category.slug,
        },
        props: { categoryName: category.name },
      }));
    }),
  );

  return paths.flat();
}

const { blogFolder } = config.settings;
const { category } = Astro.params;
const { categoryName } = Astro.props;

const postIndex = await getEntryCTM(
  blogFolder as "blog",
  "-index",
  Astro.currentLocale,
);

// Remove drafts pages in production
const response = handleDraftPage(postIndex?.data);
if (response) return response;
---

<Base {...postIndex?.data} fitToScreen={false}>
  <PageHeader
    hasBgShape={true}
    title={humanize(categoryName)}
    description={postIndex?.data.description}
  />
  <BlogSection listPage={true} category={category} />
  <CallToAction />
</Base>
