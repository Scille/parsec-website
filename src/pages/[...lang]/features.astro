---
import Base from "@/layouts/Base.astro";
import { getEntryCTM } from "@/lib/contentParser.astro";
import handleDraftPage from "@/lib/utils/handleDraftPage";
import FeaturesHero from "@/components/sections/FeaturesHero.astro";
import FeaturesSection from "@/components/sections/FeaturesSection.astro";
import OpenSourceSection from "@/components/sections/OpenSourceSection.astro";
import CallToAction from "@/components/sections/CallToAction.astro";
import { generatePaths } from "@/lib/utils/i18nUtils";
import SectorsSection from "@/components/sections/SectorsSection.astro";
import HowItWorks from "@/components/sections/HowItWorks.astro";

export function getStaticPaths() {
  return generatePaths();
}

const entry = await getEntryCTM("features", "-index", Astro.currentLocale);

// Remove drafts pages in production
const response = handleDraftPage(entry?.data);
if (response) return response;
---

<Base {...entry?.data}>
  <FeaturesHero />
  <FeaturesSection />
  <SectorsSection />
  <HowItWorks />
  <OpenSourceSection />
  <CallToAction />
</Base>
