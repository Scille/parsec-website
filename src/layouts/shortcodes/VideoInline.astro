---
// src/layouts/shortcodes/VideoInline.astro
import path from "node:path";
import bgOptimizedImage from "@/lib/utils/bgOptimizedImage";
import type { VideoConfig } from "@/types";

let {
  src,
  provider = "youtube",
  poster,
  autoplay = true,
  type,
  title = "Embedded video",
} = Astro.props as VideoConfig & { title?: string };

const isLocalHostedVideo = src?.includes("/videos/") && provider === "html5";

// Local videos are served as-is from `public/`, so they need the Astro base path prepended
if (isLocalHostedVideo && src) {
  src = path.posix.join(import.meta.env.BASE_URL, src);
}
const dailymotionId = src?.match(
  /(?:dailymotion\.com\/video\/)?([^/?]+)$/,
)?.[1];
poster = poster && (await bgOptimizedImage(poster));

const embedSrc =
  provider === "youtube"
    ? `https://www.youtube-nocookie.com/embed/${src}?rel=0&playsinline=1&autoplay=${autoplay ? 1 : 0}`
    : undefined;
---

{
  src && (
    <div class="not-prose video-inline overflow-hidden rounded-xl bg-black">
      {isLocalHostedVideo ? (
        <video
          controls
          playsinline
          preload="metadata"
          poster={poster || undefined}
          class="aspect-video w-full"
          {...(autoplay ? { autoplay: true, muted: true } : {})}>
          <source src={src} type={type} />
        </video>
      ) : provider === "dailymotion" ? (
        <div
          class="dailymotion_player aspect-video w-full"
          title={title}
          data-videoid={dailymotionId}
          data-allowfullscreen="1"
          data-autoplay={autoplay ? "1" : "0"}
          data-showinfo="0"
          data-api="0"
        />
      ) : (
        <iframe
          class="aspect-video w-full"
          src={embedSrc}
          title={title}
          loading="lazy"
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      )}
    </div>
  )
}
