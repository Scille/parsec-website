---
import { z } from "astro/zod";
import type { Section } from "@/types";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { sectionsSchema } from "@/sections.schema";
import PricingCard from "@/layouts/components/cards/PricingCard.astro";
import PricingComparisonSection from "@/components/sections/PricingComparison.astro";
import AnimatedText from "@/components/widgets/AnimatedText.astro";

export type SectionType = Section &
  z.infer<typeof sectionsSchema.pricingSection>;

type Props = {
  content?: SectionType;
  layout?: "comparison" | "regular";
  class?: string;
};

// Fetching the default content for the this section
let defaultContent = (
  await getEntryCTM("sections", "pricing-section", Astro.currentLocale)
)?.data as SectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as SectionType;

let {
  enable = true,
  title,
  description,
  caption,
  priceComparisonTitle,
  comparison,
  list,
} = actualContent as SectionType;

const { class: className, layout = "regular" } = Astro.props;

if (!enable) return;
---

<section
  class:list={[
    layout !== "regular" && "border-border-base-body mt-16 block border-t",
    className,
  ]}>
  {
    layout === "regular" ? (
      <div class="container space-y-12 md:space-y-16">
        {title && (
          <h2 class="mx-auto max-w-lg md:max-w-2xl md:text-center">
            <AnimatedText
              delay={200}
              delay={0.1}
              class="has-italic-text text-text-base-heading mb-6 md:mb-8"
              content={markdownify(title)}
            />
          </h2>
        )}
        {list && list.length > 0 && (
          <div
            class:list={[
              "grid grid-cols-1 gap-x-8 gap-y-6 pb-20 md:grid-cols-[repeat(2,minmax(480px,480px))] md:justify-center xl:gap-x-10",
            ]}>
            {list.map((item, index) => (
              <PricingCard
                content={{ ...item }}
                data-aos="fade-right-sm"
                data-aos-delay={(index + 2.5) * 100}
              />
            ))}
          </div>
        )}
      </div>
    ) : (
      <PricingComparisonSection
        content={{
          title: priceComparisonTitle,
          description: description,
          caption: caption,
          comparison,
          list,
        }}
      />
    )
  }
</section>
