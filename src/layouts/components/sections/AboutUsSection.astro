---
import type { Section } from "@/types";
import type { z } from "astro/zod";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { sectionsSchema } from "@/sections.schema";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import AnimatedText from "@/components/widgets/AnimatedText.astro";

// Type
type SectionType = Section & z.infer<typeof sectionsSchema.aboutSection>;
type Props = {
  content?: SectionType;
};

// Default content fetch
let defaultContent = (
  await getEntryCTM("sections", "about-us", Astro.currentLocale)
)?.data as SectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as SectionType;

let { enable = true, title, about, image } = actualContent as SectionType;

if (!enable) return;
---

<section class="position overflow-hidden pt-16">
  <div
    class="bg-surface-base-default-secondary pointer-events-none absolute top-0 left-0 -z-10 h-140 w-full md:h-175 lg:h-120 xl:h-140">
  </div>
  <div class="container space-y-16 md:space-y-32">
    <div class="grid grid-cols-1 gap-12 lg:grid-cols-2 lg:items-center lg:px-6">
      {
        title && (
          <h2 class="has-italic-text flex w-full max-w-2xl flex-col lg:mx-auto">
            <AnimatedText
              delay={0.2}
              stagger={0.09}
              content={markdownify(title)}
            />
          </h2>
        )
      }
      {
        image && (
          <div class="max-h-60 overflow-hidden rounded-2xl md:max-h-80 lg:max-h-96">
            <OptimizedImage
              src={image.src}
              alt={image.alt}
              class="size-full object-cover object-bottom lg:ml-auto lg:object-right"
            />
          </div>
        )
      }
    </div>
    {
      about && (
        <div class="space-y-8 pt-8 md:space-y-16 md:pt-0 lg:px-12 xl:px-24">
          {about.title && (
            <h3
              data-aos="fade-up-sm"
              class="has-italic-text"
              set:html={markdownify(about.title)}
            />
          )}
          <div class="grid gap-14 md:grid-cols-12">
            {about.image && (
              <div class="relative col-span-4 h-fit max-md:mx-auto max-md:w-fit">
                <OptimizedImage
                  width={310}
                  height={270}
                  class="size-full h-fit max-h-70 object-contain md:object-cover"
                  src={about.image}
                  alt={about.title || ""}
                />
                <div class="pointer-events-none absolute inset-0 size-full select-none">
                  <span class="translate-x-centered absolute -top-1 h-1 w-[115%] border-b border-dashed border-black/50" />
                  <span class="translate-x-centered absolute -bottom-px h-1 w-[115%] border-b border-dashed border-black/50" />
                  <span class="translate-y-centered absolute -left-px h-[115%] w-1 border-s border-dashed border-black/50" />
                  <span class="translate-y-centered absolute -right-1 h-[115%] w-1 border-s border-dashed border-black/50" />
                </div>
                <OptimizedImage
                  src="/images/about/image-shape.png"
                  class="absolute bottom-0 left-0 hidden w-full md:block"
                />
              </div>
            )}
            <div
              data-aos="fade-right-sm"
              data-aos-delay="150"
              class="space-y-7 md:col-span-8 md:space-y-14">
              {about.list && about.list.length > 0 && (
                <div class="flex flex-col flex-wrap gap-7 md:flex-nowrap md:gap-10">
                  {about.list.map((item) => (
                    <div class="flex flex-col gap-2 space-y-4 md:flex-row md:gap-8">
                      <h3
                        class="has-italic-text override-color text-text-base-description/60 text-3xl font-medium"
                        set:html={markdownify(item.title)}
                      />
                      <p
                        class="text-text-base-body text-body-lg"
                        set:html={markdownify(item.description)}
                      />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
