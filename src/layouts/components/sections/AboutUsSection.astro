---
import type { Section } from "@/types";
import type { z } from "astro/zod";
import { getEntryCTM } from "@/lib/contentParser.astro";
import { markdownify } from "@/lib/utils/textConverter";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { aboutSectionSchema } from "@/sections.schema";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import AnimatedText from "@/components/widgets/AnimatedText.astro";
import SquareElem from "@/components/widgets/SquareElem.astro";

// Type
type SectionType = Section & z.infer<typeof aboutSectionSchema>;
type Props = {
  content?: SectionType;
};

// Default content fetch
let defaultContent = (
  await getEntryCTM("sections", "about-us", Astro.currentLocale)
)?.data as SectionType;

let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as SectionType;

let { enable = true, title, about, image } = actualContent as SectionType;

if (!enable) return;
---

<section class="position overflow-hidden pt-16">
  <div
    class="bg-surface-base-default-secondary pointer-events-none absolute top-0 left-0 -z-10 h-152 w-full">
  </div>
  <div class="container space-y-16 md:space-y-32">
    <div class="flex flex-col gap-12 lg:flex-row lg:items-center">
      {
        title && (
          <div class="mx-auto flex max-w-2xl">
            <h2 class="has-italic-text">
              <AnimatedText
                delay={0.2}
                stagger={0.09}
                content={markdownify(title)}
              />
            </h2>
          </div>
        )
      }
      {
        image && (
          <OptimizedImage
            src={image.src}
            alt={image.alt}
            class="size-full max-h-96 object-contain lg:ml-auto lg:object-right"
          />
        )
      }
    </div>
    {
      about && (
        <div class="space-y-8 p-0 md:space-y-16 lg:px-12 xl:px-24">
          {about.title && (
            <h3
              data-aos="fade-up-sm"
              class="has-italic-text"
              set:html={markdownify(about.title)}
            />
          )}
          <div class="grid gap-14 md:grid-cols-12">
            {about.image && (
              <div
                class="relative h-fit md:col-span-4"
                data-aos="fade-right-sm">
                <OptimizedImage
                  width={310}
                  height={270}
                  class="size-full h-fit max-h-70 object-contain md:object-cover"
                  src={about.image}
                  alt={about.title || ""}
                />
                <div class="pointer-events-none absolute inset-0 size-full select-none">
                  <span class="translate-x-centered absolute -top-1 h-1 w-[115%] border-b border-dashed border-black/50" />
                  <span class="translate-x-centered absolute -bottom-px h-1 w-[115%] border-b border-dashed border-black/50" />
                  <span class="translate-y-centered absolute -left-px h-[115%] w-1 border-s border-dashed border-black/50" />
                  <span class="translate-y-centered absolute -right-1 h-[115%] w-1 border-s border-dashed border-black/50" />
                  <SquareElem class="absolute -top-3.5 -left-3.5 fill-white" />
                  <SquareElem class="absolute -top-3.5 -right-3.5 fill-white" />
                  <SquareElem class="absolute -bottom-3.5 -left-3.5 fill-white" />
                  <SquareElem class="absolute -right-3.5 -bottom-3.5 fill-white" />
                </div>
                <OptimizedImage
                  src="/images/about/image-shape.png"
                  class="absolute bottom-0 left-0 w-full"
                />
              </div>
            )}
            <div
              data-aos="fade-right-sm"
              data-aos-delay="150"
              class="space-y-7 md:col-span-8 md:space-y-14">
              {about.list && about.list.length > 0 && (
                <div class="flex flex-col flex-wrap gap-7 md:flex-nowrap md:gap-10">
                  {about.list.map((item) => (
                    <div class="flex flex-col gap-2 space-y-4 md:flex-row md:gap-8">
                      <h3
                        class="md:text-h3 has-italic-text override-color text-text-base-description/60 text-3xl font-medium"
                        set:html={markdownify(item.title)}
                      />
                      <p
                        class="text-text-base-body text-body-lg"
                        set:html={markdownify(item.description)}
                      />
                    </div>
                  ))}
                </div>
              )}
            </div>
          </div>
        </div>
      )
    }
  </div>
</section>
