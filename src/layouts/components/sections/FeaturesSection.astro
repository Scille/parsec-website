---
import { getEntryCTM } from "@/lib/contentParser.astro";
import overrideObjects from "@/lib/utils/overrideObjects.ts";
import type { featuresSectionSchema } from "@/sections.schema";
import type { Section } from "@/types";
import type { z } from "astro/zod";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import { markdownify } from "@/lib/utils/textConverter";

// Type for this section data
type FeatureSectionType = Section &
  NonNullable<z.infer<typeof featuresSectionSchema>>;

type Props = {
  content?: FeatureSectionType;
};

// Fetching the default content for the this section
let defaultContent = (
  await getEntryCTM("sections", "features-section", Astro.currentLocale)
)?.data as FeatureSectionType;

// Enables content customization (e.g., title, description) with a fallback to 'defaultContent' if not provided.
// The 'content' prop should match the structure of 'defaultContent'.
// Allows using this section with different content across multiple pages.
// If 'content' is missing, 'defaultContent' will be used.
let actualContent = overrideObjects(
  { ...defaultContent },
  Astro.props.content,
) as FeatureSectionType;

// Extracting required values from 'content' object
let { enable = true, items } = actualContent as FeatureSectionType;

if (!enable) return;
---

<section
  class="bg-surface-base-page relative overflow-visible pb-16 shadow-sm lg:pb-32">
  <div class="container flex flex-col gap-16 lg:gap-48">
    {
      items.map((item, index) => (
        <div
          data-feature-card
          class:list={[
            "bg-surface-base-default border-border-bas-default/20 grid grid-cols-1 items-center gap-8 rounded-4xl border p-6 shadow-lg lg:sticky lg:top-48 lg:grid-cols-2 lg:gap-16 lg:p-4",
            item.imagePosition === "right" && "lg:*:first:order-2",
          ]}>
          <div
            data-aos={index % 2 === 0 ? "fade-left-sm" : "fade-right-sm"}
            data-aos-delay={index % 2 === 0 ? 200 : 250}
            class:list={[
              "to-primary/5 flex items-center justify-center rounded-2xl bg-linear-to-b from-transparent py-8 lg:min-h-140",
              item.classOverride === true && "!items-end !justify-end !py-0",
            ]}>
            <OptimizedImage
              src={item.image}
              alt={item.title}
              height={item.imageHeight || 600}
              class="rounded-xl max-lg:max-h-75"
            />
          </div>

          <div
            class:list={[
              "flex flex-col gap-8",
              item.imagePosition === "right" && "lg:pl-8",
              item.imagePosition === "left" && "lg:pr-8",
            ]}>
            {item.title && (
              <div class="flex flex-col gap-2">
                <h2
                  class="has-italic-text text-3xl"
                  set:html={markdownify(item.title)}
                />
                {item.description && (
                  <p
                    class="text-body-xl text-text-base-body"
                    set:html={markdownify(item.description)}
                  />
                )}
              </div>
            )}

            <div class="space-y-4 divide-y divide-solid">
              {item.features.map((feature) => (
                <div class="space-y-2.5 odd:pb-8">
                  <h3 class="text-xl font-semibold">{feature.title}</h3>
                  <p class="text-text-base-description">
                    {feature.description}
                  </p>
                </div>
              ))}
            </div>
          </div>
        </div>
      ))
    }
  </div>
</section>

<script>
  const stickyOffset = 192; // px, matches "top-48"
  const fadeDistance = 550; // px of scroll over which a covered card fades out
  const minOpacity = 0;

  const cards = Array.from(
    document.querySelectorAll<HTMLElement>("[data-feature-card]"),
  );

  let ticking = false;

  function updateOpacity() {
    cards.forEach((card, i) => {
      const next = cards[i + 1];
      if (!next) {
        card.style.opacity = "1";
        return;
      }
      const distance = next.getBoundingClientRect().top - stickyOffset;
      const ratio = Math.min(Math.max(distance / fadeDistance, 0), 1);
      card.style.opacity = String(minOpacity + ratio * (1 - minOpacity));
      if (card.style.opacity === "0") {
        card.style.visibility = "hidden";
      } else {
        card.style.visibility = "visible";
      }
    });

    ticking = false;
  }

  function onScroll() {
    if (!ticking) {
      requestAnimationFrame(updateOpacity);
      ticking = true;
    }
  }

  updateOpacity();
  window.addEventListener("scroll", onScroll, { passive: true });
  window.addEventListener("resize", onScroll);
</script>
