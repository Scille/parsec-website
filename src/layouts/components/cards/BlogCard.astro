---
import type { Section } from "@/types";
import readingTime from "@/lib/utils/readingTime";
import OptimizedImage from "@/components/utilities/OptimizedImage.astro";
import {
  humanize,
  markdownify,
  plainify,
  slugifyyy,
} from "@/lib/utils/textConverter";
import { getLocaleUrlCTM } from "@/lib/utils/i18nUtils";
import Icons from "@/helpers/Icons.astro";

interface Props {
  content: Section & {
    id: string;
    collection: string;
    body?: string;
  };
  class?: string;
  layout?: "horizontal" | "vertical";
}

let { content, layout = "vertical", class: className, ...rest } = Astro.props;
let { title, image, excerpt, body, categories } = content || {};

const timeReadingEstimated = body ? readingTime(body) : undefined;

// Format categories
const categoriesArray = categories?.map((category: string) => ({
  name: category,
  slug: slugifyyy(category),
}));

let slug = getLocaleUrlCTM(content.id, Astro.currentLocale, content.collection);

const isHorizontal = layout === "horizontal";
---

<article
  class:list={[
    "bg-surface-base-page shadow-card relative flex flex-col rounded-3xl p-6",
    isHorizontal && "items-start gap-5 md:flex-row md:items-center md:gap-10",
    className,
  ]}
  {...rest}>
  <a
    class="group after:from-surface-base-default absolute inset-0 z-30 flex justify-center after:absolute after:inset-0 after:z-10 after:hidden after:rounded-3xl after:bg-linear-to-t after:to-transparent after:transition-opacity after:duration-500 after:md:block after:md:opacity-0 hover:md:after:opacity-100"
    href={slug}>
    <div class="relative z-40 h-full w-full">
      <span
        class="bg-surface-base-default pointer-events-none absolute top-full left-1/2 z-45 hidden h-16 w-16 -translate-1/2 items-center justify-center rounded-full shadow-2xl transition-[top] duration-500 group-hover:top-4/5 group-hover:rotate-45 md:flex md:opacity-0 group-hover:md:opacity-100">
        <Icons
          class="text-icon-brand-default text-2xl"
          icon="ArrowUpRightIcon"
        />
      </span>
    </div>
  </a>
  <div
    class="border-border-brand-default-subtle group relative flex h-40 min-h-40 items-center justify-center overflow-hidden rounded-xl border-4 via-20% after:pointer-events-none">
    {
      image && (
        <div class="overflow-hidden rounded-2xl">
          <OptimizedImage
            src={image}
            alt={"Related to " + title?.toLowerCase()}
            class:list={[
              "min-w-full object-cover transition duration-500 group-hover:scale-105",
              isHorizontal ? "h-[300px]! md:h-[400px]!" : "h-62.5!",
            ]}
          />
        </div>
      )
    }
    <span class="sr-only">
      {"Learn more about " + title?.toLowerCase()}
    </span>
  </div>
  <div
    class:list={[
      "flex h-full flex-col space-y-4",
      layout !== "horizontal" && "mt-4",
    ]}>
    <div class="flex flex-wrap items-center gap-x-2.5 gap-y-px">
      {
        categoriesArray?.map((category: any) => (
          <>
            <span class="bg-surface-information-default-subtle text-label-md text-text-information-default border-border-information-default-subtle rounded-2xl border px-3 py-1 leading-none font-medium">
              {humanize(category.name)}
            </span>
          </>
        ))
      }
    </div>
    {
      title && (
        <h2
          class:list={[
            isHorizontal
              ? "md:text-h3 text-h3-sm mb-8 font-medium"
              : "md:text-h4 text-h4-sm leading-h4 mb-4",
          ]}
          set:html={plainify(title)}
        />
      )
    }
    {
      excerpt && (
        <p
          class="text-body-lg text-text-base-body"
          set:html={markdownify(excerpt)}
        />
      )
    }
    {
      timeReadingEstimated && (
        <p
          class="text-body-lg text-text-base-description mt-auto"
          set:html={markdownify(timeReadingEstimated)}
        />
      )
    }
  </div>
</article>
