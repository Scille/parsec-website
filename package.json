{
  "name": "parsec-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npm run toml:watch -- --watch & astro dev",
    "web:open": "npm run toml:watch -- --watch & astro dev --open",
    "prebuild": "npm run sync-tarteaucitron",
    "build": "npm run toml:watch && astro build && npm run remove-draft-from-sitemap",
    "preview": "npm run build && astro preview",
    "astro-check": "astro check",
    "toml:watch": "node scripts/toml-watcher.mjs",
    "sync-tarteaucitron": "node ./scripts/sync-tarteaucitron.mjs",
    "postinstall": "npm run sync-tarteaucitron",
    "generate-favicons": "node ./scripts/generate-favicons.mjs",
    "generate-multilingual-content": "node ./scripts/generate-multilingual-content.mjs",
    "remove-multilingual": "node ./scripts/remove-multilingual.mjs",
    "remove-draft-from-sitemap": "node ./scripts/remove-draft-from-sitemap.mjs",
    "prettier:check": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "test": "cross-env TS_NODE_PROJECT=\"./tsconfig.jest.json\" jest",
    "test:watch": "cross-env TS_NODE_PROJECT=\"./tsconfig.jest.json\" jest --watch"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/vue": "^7.0.1",
    "@heroicons/vue": "^2.2.0",
    "@iconify-json/heroicons": "^1.2.3",
    "aos": "^2.3.4",
    "astro-auto-import": "^0.5.2",
    "astro-expressive-code": "^0.44.1",
    "astro-icon": "^1.1.5",
    "date-fns": "^4.4.0",
    "marked": "^17.0.4",
    "motion": "^12.37.0",
    "preline": "^4.2.0",
    "sharp": "^0.35.3",
    "smoothscroll-for-websites": "^1.5.1",
    "tarteaucitronjs": "^1.34.0",
    "vue": "^3.5.40"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "@astrojs/mdx": "^7.0.3",
    "@astrojs/sitemap": "^3.7.3",
    "@realfavicongenerator/generate-favicon": "^0.8.4",
    "@realfavicongenerator/image-adapter-node": "^0.8.4",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.2.1",
    "@types/jest": "^30.0.0",
    "astro": "^7.2.0",
    "cross-env": "^10.1.0",
    "gray-matter": "^4.0.3",
    "ignore": "^7.0.6",
    "jest": "^30.3.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-toml": "2.0.6",
    "rehype-external-links": "^3.0.0",
    "remark-toc": "^9.0.0",
    "slugify": "^1.6.8",
    "tailwindcss": "^4.2.1",
    "toml": "^5.0.0",
    "ts-jest": "^29.4.6",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "unist-util-visit": "^5.1.0",
    "xml2js": "^0.6.2"
  },
  "pnpm": {
    "overrides": {
      "glob": "^13.0.6",
      "inflight": "^1.0.7",
      "minimatch@<3.1.3": ">=3.1.3",
      "rollup@>=4.0.0 <4.59.0": ">=4.59.0",
      "minimatch@<3.1.4": ">=3.1.4",
      "ajv@>=7.0.0-alpha.0 <8.18.0": ">=8.18.0",
      "h3@<1.15.6": ">=1.15.6",
      "h3@<1.15.9": ">=1.15.9",
      "h3@<=1.15.8": ">=1.15.9",
      "smol-toml@<1.6.1": ">=1.6.1",
      "brace-expansion@<1.1.13": ">=1.1.13",
      "picomatch@<2.3.2": ">=2.3.2",
      "picomatch@>=4.0.0 <4.0.4": ">=4.0.4",
      "yaml@>=2.0.0 <2.8.3": ">=2.8.3",
      "defu@<=6.1.4": ">=6.1.5",
      "prettier-plugin-toml": "2.0.6"
    }
  },
  "overrides": {
    "vite": "^8.0.13",
    "yaml": "^2.8.3",
    "prettier-plugin-toml": "2.0.6"
  }
}
