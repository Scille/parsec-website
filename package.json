{
  "name": "parsec-website",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "web:open": "astro dev --open",
    "prebuild": "npm run sync-tarteaucitron",
    "build": "astro build && npm run remove-draft-from-sitemap",
    "preview": "npm run build && astro preview",
    "astro-check": "astro check",
    "sync-tarteaucitron": "node ./scripts/sync-tarteaucitron.mjs",
    "postinstall": "npm run sync-tarteaucitron",
    "generate-favicons": "node ./scripts/generate-favicons.mjs",
    "generate-multilingual-content": "node ./scripts/generate-multilingual-content.mjs",
    "remove-multilingual": "node ./scripts/remove-multilingual.mjs",
    "remove-draft-from-sitemap": "node ./scripts/remove-draft-from-sitemap.mjs",
    "prettier:check": "prettier . --check",
    "prettier:fix": "prettier . --write",
    "test": "cross-env TS_NODE_PROJECT=\"./tsconfig.jest.json\" jest",
    "test:watch": "cross-env TS_NODE_PROJECT=\"./tsconfig.jest.json\" jest --watch",
    "knip": "knip",
    "knip:fix": "knip --fix"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.2.2",
    "@astrojs/vue": "^7.0.3",
    "@heroicons/vue": "^2.2.0",
    "aos": "^2.3.4",
    "astro-expressive-code": "^0.44.2",
    "astro-icon": "^1.1.5",
    "date-fns": "^4.4.0",
    "marked": "^18.0.13",
    "motion": "^13.4.0",
    "preline": "^5.0.0",
    "sharp": "^0.35.3",
    "smoothscroll-for-websites": "^1.5.1",
    "tarteaucitronjs": "^1.34.0",
    "vue": "^3.5.43"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@astrojs/mdx": "^8.0.1",
    "@astrojs/sitemap": "^3.7.4",
    "@jest/globals": "30.5.2",
    "@realfavicongenerator/generate-favicon": "^0.9.0",
    "@realfavicongenerator/image-adapter-node": "^0.9.0",
    "@tailwindcss/forms": "^0.5.11",
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.3",
    "@types/jest": "^30.0.0",
    "astro": "^7.3.3",
    "cross-env": "^10.1.0",
    "gray-matter": "^4.0.3",
    "jest": "^30.5.2",
    "knip": "^6.37.0",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.6",
    "prettier-plugin-astro": "^0.14.1",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "prettier-plugin-toml": "2.0.3",
    "rehype-external-links": "^3.0.0",
    "remark-toc": "^9.0.0",
    "slugify": "^1.6.8",
    "tailwindcss": "^4.2.1",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0",
    "xml2js": "^0.6.2"
  }
}
